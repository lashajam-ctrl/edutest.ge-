{
  "name": "edutest-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "start": "vinext start",
    "test": "node scripts/check-browser-syntax.mjs && node --test tests/assessment-selection.test.mjs tests/question-policy.test.mjs tests/security-regression.test.mjs tests/secure-assessment.test.mjs tests/claude-audit-regression.test.mjs tests/v8-question-bank.test.mjs tests/v11-platform-import.test.mjs && vinext build",
    "audit:v8-bank": "node scripts/import-v8-question-bank.mjs --dry-run",
    "audit:v11-bank": "node scripts/import-v11-question-bank.mjs --dry-run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "audit:questions": "node --test tests/secure-assessment.test.mjs tests/question-policy.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
